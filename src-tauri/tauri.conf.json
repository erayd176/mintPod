{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PodPilot",
  "version": "0.1.0",
  "identifier": "dev.podpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "PodPilot",
        "width": 360,
        "height": 480,
        "minWidth": 360,
        "minHeight": 480,
        "maxWidth": 360,
        "maxHeight": 480,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
