{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mintpod.dev/schemas/preset.json",
  "title": "mintPod model preset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "ollamaTag",
    "sizeGb",
    "minVramGb",
    "gpuTypeIds",
    "estCostPerHr",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "ollamaTag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+(?::[A-Za-z0-9._-]+)?$",
      "minLength": 1,
      "maxLength": 160
    },
    "sizeGb": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 4000
    },
    "minVramGb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "gpuTypeIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "estCostPerHr": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 32
      }
    }
  }
}

